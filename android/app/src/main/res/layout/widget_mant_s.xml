<?xml version="1.0" encoding="utf-8"?>
<!-- Generado a mano a partir del sistema de widgets de V2-M25: gradiente de marca,
     esquinas grandes, jerarquia tipografica y cifras que se ajustan al tamano. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad_s">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        >
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_texto_secundario"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_con_datos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        >
        <TextView
            android:id="@+id/mant_servicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_demo_servicio"
            android:textColor="@color/widget_texto_secundario"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center_vertical"
            >
            <TextView
                android:id="@+id/mant_faltan"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/widget_demo_faltan"
                android:textColor="@color/widget_texto"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="2sp"
                />
            <TextView
                android:id="@+id/mant_faltan_urgente"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/widget_demo_faltan"
                android:textColor="@color/widget_peligro"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="2sp"
                android:visibility="gone"
                />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/mant_barra"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_barra_progreso"
            />
        <ProgressBar
            android:id="@+id/mant_barra_urgente"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_barra_urgente"
            android:visibility="gone"
            />
        <TextView
            android:id="@+id/mant_fecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_demo_fecha"
            android:textColor="@color/widget_texto_secundario"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="6dp"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_vacio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        >
        <TextView
            android:id="@+id/w_mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_vacio_mant"
            android:textColor="@color/widget_texto"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:ellipsize="end"
            />
        <TextView
            android:id="@+id/w_accion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_accion_abrir"
            android:textColor="@color/widget_sobre_acento"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:background="@drawable/widget_boton"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="8dp"
            />
    </LinearLayout>
</LinearLayout>
