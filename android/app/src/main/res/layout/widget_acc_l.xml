<?xml version="1.0" encoding="utf-8"?>
<!-- Generado a mano a partir del sistema de widgets de V2-M25: gradiente de marca,
     esquinas grandes, jerarquia tipografica y cifras que se ajustan al tamano. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad_l">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        >
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_texto_secundario"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_con_datos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1"
            >
            <LinearLayout
                android:id="@+id/acc_btn_agendar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/widget_fondo_chip"
                android:layout_margin="4dp"
                android:clickable="true"
                >
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_widget_agendar"
                    android:tint="@color/widget_acento"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/acc_txt_agendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_acc_agendar"
                    android:textColor="@color/widget_texto"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="8dp"
                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/acc_btn_mi_auto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/widget_fondo_chip"
                android:layout_margin="4dp"
                android:clickable="true"
                >
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_widget_mi_auto"
                    android:tint="@color/widget_acento"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/acc_txt_mi_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_acc_mi_auto"
                    android:textColor="@color/widget_texto"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="8dp"
                    />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_weight="1"
            >
            <LinearLayout
                android:id="@+id/acc_btn_sos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/widget_fondo_chip"
                android:layout_margin="4dp"
                android:clickable="true"
                >
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_widget_sos"
                    android:tint="@color/widget_peligro"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/acc_txt_sos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_acc_sos"
                    android:textColor="@color/widget_texto"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="8dp"
                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/acc_btn_comprobante"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/widget_fondo_chip"
                android:layout_margin="4dp"
                android:clickable="true"
                >
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_widget_comprobante"
                    android:tint="@color/widget_acento"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/acc_txt_comprobante"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_acc_comprobante"
                    android:textColor="@color/widget_texto"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="8dp"
                    />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
