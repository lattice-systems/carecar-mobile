<?xml version="1.0" encoding="utf-8"?>
<!-- Generado a mano a partir del sistema de widgets de V2-M25: gradiente de marca,
     esquinas grandes, jerarquia tipografica y cifras que se ajustan al tamano. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad_l">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        >
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_texto_secundario"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_con_datos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        >
        <TextView
            android:id="@+id/cita_mes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_demo_mes"
            android:textColor="@color/widget_acento"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            />
        <TextView
            android:id="@+id/cita_dia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/widget_demo_dia"
            android:textColor="@color/widget_texto"
            android:textSize="120sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:layout_weight="2"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="40sp"
            android:autoSizeMaxTextSize="120sp"
            android:autoSizeStepGranularity="2sp"
            />
        <TextView
            android:id="@+id/cita_semana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_demo_semana"
            android:textColor="@color/widget_texto_secundario"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            />
        <View android:layout_width="match_parent" android:layout_height="14dp" />
        <TextView
            android:id="@+id/cita_horario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_demo_horario"
            android:textColor="@color/widget_texto"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            />
        <TextView
            android:id="@+id/cita_vehiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_demo_auto"
            android:textColor="@color/widget_texto_secundario"
            android:textSize="17sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="4dp"
            />
        <View android:layout_width="match_parent" android:layout_height="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_vacio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        >
        <TextView
            android:id="@+id/w_mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_vacio_cita"
            android:textColor="@color/widget_texto"
            android:textSize="18sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="4"
            android:ellipsize="end"
            />
        <TextView
            android:id="@+id/w_accion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_accion_abrir"
            android:textColor="@color/widget_sobre_acento"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:background="@drawable/widget_boton"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="12dp"
            />
    </LinearLayout>
</LinearLayout>
