<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de la proxima cita (V2-M25.01). Con cita se ven fecha, horario y
     vehiculo; sin cita, el mensaje y el boton para agendar. El proveedor
     Kotlin decide cual de los dos bloques se muestra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cita_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_proxima_cita_fondo"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_cita_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_proxima_cita_nombre"
        android:textColor="@color/widget_cita_texto_secundario"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_cita_con_cita"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/widget_cita_fecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_cita_texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_cita_horario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_cita_texto"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_cita_vehiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:textColor="@color/widget_cita_texto_secundario"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_cita_sin_cita"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_cita_mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_proxima_cita_vacio"
            android:textColor="@color/widget_cita_texto"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_cita_accion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:textColor="@color/widget_cita_acento"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
