<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de los widgets de inicio (V2-M25): degradado sutil de la marca, sin
     borde y con esquinas grandes. Sigue el modo claro u oscuro por los colores. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/widget_fondo_fin"
        android:startColor="@color/widget_fondo_inicio"
        android:type="linear" />
    <corners android:radius="@dimen/widget_radio" />
</shape>
