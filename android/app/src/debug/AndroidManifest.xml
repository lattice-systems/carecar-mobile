<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- HTTP sin cifrar: ya NO se decide aqui por tipo de compilacion, sino por
         flavor (V2-T01.04). `usesCleartextTraffic` sale del marcador
         `${usesCleartextTraffic}` del manifiesto principal: true solo en
         `desarrollo` (mock_api y backend local sobre http://), false en
         `pruebas` y `produccion` aunque sean de depuracion. Si se pusiera aqui,
         chocaria con el valor del flavor al fusionar los manifiestos.

         Direcciones utiles en desarrollo (RIC-20):
           emulador de Android -> http://10.0.2.2:8080/api/v1/app   (backend local)
           emulador de Android -> http://10.0.2.2:3000/api/v1/app   (API simulada)
    -->
</manifest>
