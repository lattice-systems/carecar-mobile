migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Credenciales de firma (android/.gitignore solo cubre el subarbol android/)
*.keystore
*.jks
key.properties

# Contexto de trabajo local para Claude Code (solo uso local del equipo).
# Se excluye .claude/context/ y no todo .claude/, para dejar la puerta abierta
# a versionar mas adelante configuracion compartida en .claude/settings.json.
.claude/context/
.claude/settings.local.json
CLAUDE.local.md

# Reporte de auditoria de seguridad (el repo es publico; no se versiona)
SECURITY_REPORT.md
